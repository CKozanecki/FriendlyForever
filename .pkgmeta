# CurseForge / BigWigs packager configuration. The packager zips this
# repository as a single FriendlyForever/ folder, minus the paths below.
package-as: FriendlyForever

ignore:
  - spec
  - uitests
  - scripts
  - art
  - dist
  - .github
  - .vscode
  - .busted
  - .luacheckrc
  - .gitignore
  - Makefile
  - CONTRIBUTING.md
  - CLAUDE.md
  - SECURITY.md
  - RELEASE_NOTES.md

# Release notes on CurseForge are this version's section of the changelog,
# written by scripts/release-notes.sh (make release-notes) before packaging.
manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown
